{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "playwright-chromium": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest", "--browser=chromium"]
      },
      "playwright-firefox": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest", "--browser=firefox"]
      }
    }
  }
}
